{
	"name": "color-code-convertor",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@sentry/vite-plugin": "^11.10.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/culori": "^4.0.1",
		"@types/node": "^26.6.6",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@sentry/browser": "^11.10.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"culori": "^4.0.2"
	},
	"description": "Paste a color in any format, get all seventeen others",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NotAFlightRisk/color-code-convertor.git"
	},
	"homepage": "https://color-code-convertor.peng.ly",
	"engines": {
		"node": "^22.17.0 || >=24.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
